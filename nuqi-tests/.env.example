# ─────────────────────────────────────────────────────────────
#  Nuqi Wealth UAT — Environment Variables
#  Copy this file to .env and fill in values before running.
# ─────────────────────────────────────────────────────────────

# Base URL (already set in playwright.config.ts but can override)
BASE_URL=https://uat.nuqiwealth.com

# ── Test Users ────────────────────────────────────────────────
# New user (no KYC, no risk profile)
TEST_NEW_USER_EMAIL=test.new@nuqiuat.com
TEST_NEW_USER_PASSWORD=Test@1234

# OTP user
TEST_OTP_USER_EMAIL=test.otp@nuqiuat.com
TEST_OTP_USER_PASSWORD=Test@1234
TEST_OTP=123456

# Returning user (KYC verified, risk profile complete)
TEST_RETURNING_EMAIL=test.returning@nuqiuat.com
TEST_RETURNING_PASSWORD=Test@1234

# Power user (KYC verified, has existing holdings)
TEST_POWER_EMAIL=test.power@nuqiuat.com
TEST_POWER_PASSWORD=Test@1234

# Incomplete KYC user (started but not finished KYC)
TEST_INCOMPLETE_KYC_EMAIL=test.incomplete@nuqiuat.com
TEST_INCOMPLETE_KYC_PW=Test@1234

# Auto-KYC user (data pre-seeded via API)
TEST_AUTO_KYC_EMAIL=test.autokyc@nuqiuat.com
TEST_AUTO_KYC_PW=Test@1234

# Single-holding user (for full-exit empty-state test)
TEST_SINGLE_HOLDING_USER=test.single@nuqiuat.com

# ── Social Auth ───────────────────────────────────────────────
GOOGLE_TEST_EMAIL=nuqitest@gmail.com
GOOGLE_TEST_PASSWORD=GoogleTest@1234
APPLE_TEST_EMAIL=nuqitest@icloud.com
APPLE_TEST_PASSWORD=AppleTest@1234

# ── CI / Parallel config ──────────────────────────────────────
CI=false
