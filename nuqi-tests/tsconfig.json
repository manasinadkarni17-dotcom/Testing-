{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],

    "types": ["node", "@playwright/test"],

    "outDir": "./dist",
    "rootDir": ".",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "types/**/*",
    "utils/**/*",
    "pages/**/*",
    "fixtures/**/*",
    "tests/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
